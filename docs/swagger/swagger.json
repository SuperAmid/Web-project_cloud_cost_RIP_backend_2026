{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Маршрутизаторы сети провайдера: список, лента, черновик, публикация, лайки.\nБез авторизации доступно только чтение. Чтобы вызвать методы создателя,\nвыполните вход и нажмите Authorize: Bearer \u003caccess_token\u003e.",
        "title": "provider_routers API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/provider_router_users/login": {
            "post": {
                "description": "Токен из access_token передаётся в заголовке Authorization: Bearer \u003cтокен\u003e.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_router_users"
                ],
                "summary": "Вход: выдача JWT",
                "parameters": [
                    {
                        "description": "email и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterUserLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterUserLoginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_router_users/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Текущий токен попадает в blacklist Redis до конца срока действия.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_router_users"
                ],
                "summary": "Выход",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.MessageResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_router_users/register": {
            "post": {
                "description": "Пароль хранится как bcrypt-хеш.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_router_users"
                ],
                "summary": "Регистрация",
                "parameters": [
                    {
                        "description": "email, имя, пароль 6–72 байта",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterUserRegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterUserResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_routers": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Только опубликованные, фильтры выполняются в БД. is_own = 1, если создатель — текущий пользователь (для гостя 0). Доступно без авторизации.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_routers"
                ],
                "summary": "Список маршрутизаторов",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Минимальная пропускная способность, Мбит/с",
                        "name": "min_bandwidth_mbps",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Максимальная стоимость, ₽",
                        "name": "max_cost_rub",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/serializer.ProviderRouterListItem"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Файлы сохраняются в MinIO под латинскими именами, создатель — пользователь из токена.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_routers"
                ],
                "summary": "Создание черновика с фото и видео",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Фото: jpg, jpeg, png, webp, svg до 10 МБ",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Видео: mp4, webm, mov до 50 МБ",
                        "name": "video",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterDraft"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_routers/draft": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Не более одного черновика у пользователя, id не указывается.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_routers"
                ],
                "summary": "Черновик текущего пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterDraft"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_routers/feed": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Без id — первая опубликованная, с id — эта, с id и next=true — следующая (после последней — первая). is_liked = 1, если текущий пользователь лайкнул (для гостя 0). Доступно без авторизации.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_routers"
                ],
                "summary": "Лента: одна карточка",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Id маршрутизатора",
                        "name": "id",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Следующая после id",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterFeedItem"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_routers/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "status = deleted, запись больше не отдаётся клиенту.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_routers"
                ],
                "summary": "Логическое удаление своей записи",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Id маршрутизатора",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterDraft"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_routers/{id}/like": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "like = 1 ставит лайк, 0 снимает.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_routers"
                ],
                "summary": "Лайк от текущего пользователя",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Id маршрутизатора",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "0 или 1",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterLikeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterLikeResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/provider_routers/{id}/publish": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "draft → published, published_at ставит сервер. В той же транзакции заполняются описание и два поля по теме.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "provider_routers"
                ],
                "summary": "Публикация своего черновика",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Id черновика",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Описание и поля по теме",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterPublishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.ProviderRouterDraft"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "serializer.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "serializer.MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "serializer.ProviderRouterDraft": {
            "type": "object",
            "properties": {
                "bandwidth_mbps": {
                    "type": "integer"
                },
                "cost_rub": {
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_key": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "published_at": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "video_key": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "serializer.ProviderRouterFeedItem": {
            "type": "object",
            "properties": {
                "bandwidth_mbps": {
                    "type": "integer"
                },
                "cost_rub": {
                    "type": "integer"
                },
                "creator_name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "is_liked": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "published_at": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "serializer.ProviderRouterLikeRequest": {
            "type": "object",
            "properties": {
                "like": {
                    "type": "integer"
                }
            }
        },
        "serializer.ProviderRouterLikeResponse": {
            "type": "object",
            "properties": {
                "is_liked": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "provider_router_id": {
                    "type": "integer"
                }
            }
        },
        "serializer.ProviderRouterListItem": {
            "type": "object",
            "properties": {
                "bandwidth_mbps": {
                    "type": "integer"
                },
                "cost_rub": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "is_own": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "published_at": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "serializer.ProviderRouterPublishRequest": {
            "type": "object",
            "properties": {
                "bandwidth_mbps": {
                    "type": "integer"
                },
                "cost_rub": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                }
            }
        },
        "serializer.ProviderRouterUserLoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "serializer.ProviderRouterUserLoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "description": "секунд до истечения",
                    "type": "integer",
                    "example": 3600
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                },
                "user": {
                    "$ref": "#/definitions/serializer.ProviderRouterUserResponse"
                }
            }
        },
        "serializer.ProviderRouterUserRegisterRequest": {
            "type": "object",
            "properties": {
                "display_name": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "serializer.ProviderRouterUserResponse": {
            "type": "object",
            "properties": {
                "display_name": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите: Bearer \u003caccess_token из ответа входа\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}