{
  "info": {
    "name": "provider_routers — ЛР3",
    "description": "Веб-сервис маршрутизаторов провайдера. Запросы идут в порядке показа.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "provider_router_id",
      "value": ""
    },
    {
      "key": "feed_id",
      "value": ""
    },
    {
      "key": "user_email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Маршрутизаторы (provider_routers)",
      "item": [
        {
          "name": "01 Список с фильтром",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/provider_routers?min_bandwidth_mbps=10000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "provider_routers"
              ],
              "query": [
                {
                  "key": "min_bandwidth_mbps",
                  "value": "10000"
                }
              ]
            },
            "description": "Только опубликованные; is_own = 1, если создатель — текущий пользователь. Доп. фильтр: max_cost_rub."
          }
        },
        {
          "name": "02 Добавление с фото и видео",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/provider_routers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "provider_routers"
              ]
            },
            "description": "Выберите файлы в полях image и video. Создаёт черновик, файлы уходят в MinIO.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Ozerki Residence Gateway",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": ".jpg .jpeg .png .webp .svg до 10 МБ"
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": [],
                  "description": ".mp4 .webm .mov до 50 МБ"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  pm.collectionVariables.set('provider_router_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Черновик (без id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/provider_routers/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "provider_routers",
                "draft"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  pm.collectionVariables.set('provider_router_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Публикация",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/provider_routers/{{provider_router_id}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "provider_routers",
                "{{provider_router_id}}",
                "publish"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Конечный маршрутизатор ЖК «Озерки» на 240 квартир.\",\n  \"bandwidth_mbps\": 2500,\n  \"cost_rub\": 84000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "05 Лента без id",
          "request": {
            "method": "GET",
