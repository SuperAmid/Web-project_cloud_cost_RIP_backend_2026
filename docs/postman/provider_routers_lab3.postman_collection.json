              "raw": "{{baseUrl}}/api/provider_routers/feed?id={{feed_id}}&next=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "provider_routers",
                "feed"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{feed_id}}"
                },
                {
                  "key": "next",
                  "value": "true"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "07 Лайк (1 — поставить, 0 — снять)",
          "request": {
            "method": "POST",
            "header": [
