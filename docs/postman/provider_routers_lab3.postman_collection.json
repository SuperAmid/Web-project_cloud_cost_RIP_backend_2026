            "url": {
              "raw": "{{baseUrl}}/api/provider_routers/{{provider_router_id}}/like",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "provider_routers",
                "{{provider_router_id}}",
                "like"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"like\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "08 Удаление (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/provider_routers/{{provider_router_id}}",
